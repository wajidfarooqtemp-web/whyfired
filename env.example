# Copy this file to .env (same folder) and fill in your own values
# from Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# From Google Cloud Console > APIs & Services > Credentials, the
# same OAuth Client you already created for Supabase. This is the
# Client ID only, never the Client Secret; it's safe to expose in
# frontend code.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
